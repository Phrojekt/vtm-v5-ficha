# Copie para um arquivo chamado .env (na VPS) e ajuste. Nunca suba o .env para o git.
# Banco próprio da ficha, no mesmo Postgres do Precifa (usuário e banco separados)
DATABASE_URL=postgres://fichas:TROQUE_ESTA_SENHA@postgres:5432/fichas
# Sites que podem chamar a API, separados por vírgula
ORIGENS=https://vtmfichas.vercel.app,http://localhost:4777
# Endereço do site, usado para montar o link de compartilhamento
SITE_URL=https://vtmfichas.vercel.app
PORTA=3000
# 'nao' fecha o cadastro de contas novas
PERMITIR_CADASTRO=sim
DIAS_SESSAO=60
MINUTOS_POR_VERSAO=10
MAX_VERSOES=100
